{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/emrecpn/fluova/content/schema/test.schema.json",
  "title": "Fluova practice test",
  "description": "One full practice test in the format of the TOEFL iBT® test (January 2026). Every test must also pass tools/validate.js and tools/lint_forms.js.",
  "type": "object",
  "required": ["id", "title", "version", "license", "sections"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "File name without .json, e.g. pilot-01" },
    "title": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "license": { "const": "CC-BY-SA-4.0" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "level": { "enum": ["easy", "medium", "hard", "real"], "description": "real = adaptive, like the actual test" },
    "units": { "type": "array", "items": { "type": "string" }, "description": "Question-bank unit ids this test was built from (written by tools/bank.js)" },
    "generatedBy": { "type": "string", "description": "Optional: tool or model used to draft the test (human review still required)" },
    "notes": { "type": "string" },
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "minutes", "screens"],
        "properties": {
          "id": { "enum": ["reading", "listening", "writing", "speaking"] },
          "name": { "type": "string" },
          "minutes": { "type": "number", "minimum": 1 },
          "oneWay": { "type": "boolean" },
          "intro": { "$ref": "#/definitions/localized" },
          "screens": { "type": "array", "items": { "$ref": "#/definitions/screen" } },
          "adaptive": {
            "type": "object",
            "required": ["routeFrom", "threshold", "hard", "easy"],
            "properties": {
              "routeFrom": { "type": "array", "items": { "type": "string" }, "description": "Question ids from the router module" },
              "threshold": { "type": "integer", "minimum": 1 },
              "hard": { "type": "array", "items": { "$ref": "#/definitions/screen" } },
              "easy": { "type": "array", "items": { "$ref": "#/definitions/screen" } }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "localized": {
      "description": "Plain string, or an object keyed by language code (en, tr, es...)",
      "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }]
    },
    "mcq": {
      "type": "object",
      "required": ["id", "stem", "options", "answer"],
      "properties": {
        "id": { "type": "string" },
        "stem": { "type": "string" },
        "options": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string" } },
        "answer": { "type": "integer", "minimum": 0, "maximum": 3, "description": "Index of the correct option. The engine shuffles options on screen." },
        "why": { "$ref": "#/definitions/localized" }
      }
    },
    "audioLine": {
      "type": "object", "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "voice": { "type": "string", "pattern": "^(neutral|female|male)(:(us|gb|au))?$" },
        "rate": { "type": "number" }
      }
    },
    "screen": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["ctw", "passage", "text_chain", "insert_text", "choose_response", "listening", "sentence_dialogue", "writing", "listen_repeat", "interview"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "ctw" } } }, "then": { "required": ["title", "text", "items"], "properties": { "items": { "type": "array", "items": { "type": "object", "required": ["id", "stub", "answer"] } } } } },
        { "if": { "properties": { "type": { "const": "passage" } } }, "then": { "required": ["title", "directions", "text", "questions"], "properties": { "questions": { "type": "array", "items": { "$ref": "#/definitions/mcq" } } } } },
        { "if": { "properties": { "type": { "const": "text_chain" } } }, "then": { "required": ["messages", "questions"] } },
        { "if": { "properties": { "type": { "const": "choose_response" } } }, "then": { "required": ["id", "audio", "options", "answer"], "properties": { "audio": { "type": "array", "items": { "$ref": "#/definitions/audioLine" } } } } },
        { "if": { "properties": { "type": { "const": "listening" } } }, "then": { "required": ["title", "audio", "questions"], "properties": { "audio": { "type": "array", "items": { "$ref": "#/definitions/audioLine" } }, "questions": { "type": "array", "items": { "$ref": "#/definitions/mcq" } } } } },
        { "if": { "properties": { "type": { "const": "sentence_dialogue" } } }, "then": { "required": ["id", "personA", "answer"], "properties": { "frame": { "type": "array", "description": "Sentence skeleton; null marks a blank. Number of nulls must equal answer length." }, "answer": { "type": "array", "items": { "type": "string" } }, "distractors": { "type": "array", "maxItems": 1 } } } },
        { "if": { "properties": { "type": { "const": "writing" } } }, "then": { "required": ["id", "kind", "minutes", "prompt"], "properties": { "kind": { "enum": ["email", "discussion"] } } } },
        { "if": { "properties": { "type": { "const": "listen_repeat" } } }, "then": { "required": ["id", "scenario", "sentences"], "properties": { "sentences": { "type": "array", "minItems": 7, "maxItems": 7 } } } },
        { "if": { "properties": { "type": { "const": "interview" } } }, "then": { "required": ["id", "scenario", "questions"], "properties": { "questions": { "type": "array", "minItems": 4, "maxItems": 4 } } } }
      ]
    }
  }
}
